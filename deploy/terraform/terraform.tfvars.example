project_id = "replace-with-gcp-project-id"
region     = "us-central1"

repository_id = "comprehension-verification"
service_name  = "cva-web"
job_name      = "cva-worker"

# Apply the connection first, complete the official OAuth/GitHub App flow,
# record its public installation id, and only then enable the repository/trigger.
enable_cloud_build_connection = false
github_app_installation_id    = null
github_oauth_token_secret_version = null # Resource name only; never put a token here.
enable_cloud_build_trigger    = false

# First apply with false. Add Secret Manager version 1 values out-of-band,
# build/push an image, resolve its digest from Artifact Registry, then copy the
# exact REGION/PROJECT/REPOSITORY/application@sha256 reference into an
# unversioned copy of this file and set this to true.
enable_runtime_resources = false
container_image          = ""
secret_version           = "1"
synthetic_evaluation_job_name = "cva-synthetic-eval"

# Synthetic-evaluation capability: the worker receives only a pinned Secret
# Manager resource name. It must first claim the exact job and consume a
# matching append-only authorization before it may resolve the value. Never
# place the key value in this file.
enable_openai_secret_container             = false
enable_synthetic_evaluation_provider       = false
openai_api_key_secret_version              = null
synthetic_evaluation_candidate_sha         = null
synthetic_evaluation_max_requests          = null
synthetic_evaluation_max_job_cost_usd      = null

supabase_url             = "https://replace-with-project-ref.supabase.co"
supabase_publishable_key = "replace-with-publishable-not-secret-key"
supabase_jwt_audience    = "authenticated"

r2_endpoint_url = "https://replace-with-account-id.r2.cloudflarestorage.com"
r2_bucket_name  = "replace-with-private-bucket-name"

upload_url_ttl_seconds   = 900
download_url_ttl_seconds = 300

allow_unauthenticated = true
