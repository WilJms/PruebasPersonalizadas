      "independent_semantic_evidence": false,
      "note": "Fixed prose ('Relaciones categoricas P06 materializadas por el servidor.'). It is a constant and therefore carries no information about any field's authority. It must never be read as evidence that the neighbouring support_status is server-owned."
    },
    {
      "authority": "SERVER_DERIVED_FROM_MODEL_INPUT",
      "contract": "EvidenceVariantMatch",
      "derivation": "0.0 when the aggregate model status is UNCERTAIN, otherwise 1.0",
