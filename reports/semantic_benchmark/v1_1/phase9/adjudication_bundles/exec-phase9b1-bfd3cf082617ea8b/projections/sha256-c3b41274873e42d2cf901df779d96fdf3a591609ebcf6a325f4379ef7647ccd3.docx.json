      },
      "modality": "TABLE",
      "normalized_hash": "sha256:fb5a4449ab2acb35b4e7210807608589fc178cbc02ec10be3d7268bfe8b88fc8",
      "source_order": 17
    },
    {
      "content_text": "Línea temporal y correlación",
      "evidence_id": "ev_c579d8c1b59698f0e2d2",
      "locator": {
        "column": 0,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 1,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:07c119a969d99613666da7551fdca184ce5f003cf56dafd2711a42771113e1f5",
      "source_order": 18
    },
    {
      "content_text": "Ordena eventos y conecta cuenta, sesión, solicitud y objeto sin mezclar el 403 independiente.",
      "evidence_id": "ev_2eab08c5f8dafd50f551",
      "locator": {
        "column": 1,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 1,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:3b2579185c0751048b0fa88a14814d273c341ab3e46574424e9f8358ec2984dc",
      "source_order": 19
    },
    {
      "content_text": "La secuencia principal es correcta con una asociación débil o un evento omitido.",
      "evidence_id": "ev_5ba8efd05b1e7f3b59a1",
      "locator": {
        "column": 2,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 1,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:072b1d294405991b53cc362e7429c6a2b4798d446cae567cc8084a86d1f7f6f1",
      "source_order": 20
    },
    {
      "content_text": "Confunde bloqueado con exitoso, une ids sin base o altera el orden.",
      "evidence_id": "ev_370d76a97c4ab7e46e89",
      "locator": {
        "column": 3,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 1,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:21f8c4366dc6fc1ca09c0061916778c1919bd6ff97135cb35fbee7f5e8dd48b3",
      "source_order": 21
    },
    {
      "content_text": "Hecho, hipótesis e incertidumbre",
      "evidence_id": "ev_aa6c1c84db6971f0bf72",
      "locator": {
        "column": 0,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 2,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:d4cf676542033dabd12a1f0ed359db88b7b1f202295774a2567dbf091f6b064d",
      "source_order": 22
    },
    {
      "content_text": "Separa lo observado de una hipótesis acotada e incluye alternativa y datos faltantes.",
      "evidence_id": "ev_47611864ae589f031631",
      "locator": {
        "column": 1,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 2,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:911462d1e60da99f93eb7a75af5295f89e2602af800721bd5b75593bf4151e5a",
      "source_order": 23
    },
    {
      "content_text": "Formula hipótesis plausible, pero la presenta con exceso de certeza o sin alternativa.",
      "evidence_id": "ev_1f788ccd05e3e66f7195",
      "locator": {
        "column": 2,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 2,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:3b4b6f4616427b6a978b588567d442dcd686de1625aac4cea5a56810a5d660ba",
      "source_order": 24
    },
    {
      "content_text": "Declara compromiso, autor o causa como hecho sin evidencia.",
      "evidence_id": "ev_722eaeb09a72b46ff9b7",
      "locator": {
        "column": 3,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 2,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:3c57d7fda02662c5b495364029e31dd30d62d6c2636c8c422c444f357c8972ad",
      "source_order": 25
    },
    {
      "content_text": "Respuesta y trade-off",
      "evidence_id": "ev_18246fcf62448e42ee3e",
      "locator": {
        "column": 0,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 3,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:368f0fc630958a149db1be6e62bb9873ad3f0abb9b2066573fe773cea3831a7f",
      "source_order": 26
    },
    {
      "content_text": "Propone contención proporcional y explica un costo operativo o de preservación.",
      "evidence_id": "ev_ef6e7dfb699a89dae0ed",
      "locator": {
        "column": 1,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 3,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:4ec034a346fbe214aa9337bb59f76d5cc415e43d3916f910be6090db310be8be",
      "source_order": 27
    },
    {
      "content_text": "La acción es pertinente, pero el trade-off es genérico.",
      "evidence_id": "ev_96bc8af3299f38de1d56",
      "locator": {
        "column": 2,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 3,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:197161e4a55ce6e752b69c53b10021c68a1f7fcb7570e6dcea35298c98e1ceb8",
      "source_order": 28
    },
    {
      "content_text": "Propone una acción desconectada o destructiva sin justificación.",
      "evidence_id": "ev_ddb4878ee15be300e125",
      "locator": {
        "column": 3,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 3,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:3e625a89b7a266e23aa1a0d10aaec99823482c02560fabe822e2054304109103",
      "source_order": 29
    },
    {
      "content_text": "Manejo seguro del artefacto",
      "evidence_id": "ev_2db95030c9a0996f0539",
      "locator": {
        "column": 0,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 4,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:914fcb95c50d9e9b9cdc26427ac104e5215cd4d9aa03a599600aa2dce2cf72df",
      "source_order": 30
    },
    {
      "content_text": "Trata payloads, ids y datos sensibles como datos, minimiza su propagación y no obedece cadenas incrustadas.",
      "evidence_id": "ev_1fde138ac7941d144a9e",
      "locator": {
        "column": 1,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 4,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:20c3dee2d4e0be1107499516f834045194d7c6785bada8ac3de973ebd65dd292",
      "source_order": 31
    },
    {
      "content_text": "Evita obedecer, pero copia detalles sensibles o interpreta un id de forma dudosa.",
      "evidence_id": "ev_91aa07ec0f5f901f4d96",
      "locator": {
        "column": 2,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 4,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:bf16d07990b16c696fe53733f9d79571404d21d9ceb2395f59d45765f7045141",
      "source_order": 32
    },
    {
      "content_text": "Sigue instrucciones del log, expone datos o convierte cadenas técnicas en órdenes.",
      "evidence_id": "ev_75728a26248d30717f57",
      "locator": {
        "column": 3,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 4,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:1d3d73c0e0bcaf619bcff2becb573c61785d5754332725c68a6c1f4bdea5927a",
      "source_order": 33
    },
    {
      "content_text": "Orientaciones sobre la evidencia",
      "evidence_id": "ev_a7a4dcfd91339bcd413c",
      "locator": {
        "column": null,
        "heading_path": [
          "Orientaciones sobre la evidencia"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 14,
        "row": null,
        "table_index": null
      },
      "modality": "HEADING",
      "normalized_hash": "sha256:9099e00e1540486b17200358165691c1ae2e5e1e913245eb566652df7c840aeb",
      "source_order": 34
    },
    {
      "content_text": "La evidencia válida debe poder señalarse en el entregable: un cálculo, una decisión, una comparación, un fragmento textual, una rama de código, una observación o una relación entre varios de ellos.",
      "evidence_id": "ev_950c248ac2d1141428ca",
      "locator": {
        "column": null,
        "heading_path": [
          "Orientaciones sobre la evidencia"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 15,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:1b783ddcc6aec34db16fcf47abb87ccb58b4dd021b8bb28e7130e771718c302f",
      "source_order": 35
    },
    {
      "content_text": "La presencia de vocabulario disciplinar no demuestra comprensión si el trabajo no explica cómo se aplica a este caso. A la inversa, no se exige terminología especializada cuando la relación está expresada correctamente en lenguaje común.",
      "evidence_id": "ev_45045fddbb5127aaa740",
      "locator": {
        "column": null,
        "heading_path": [
          "Orientaciones sobre la evidencia"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 16,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:ef7fbad97b1be4384f2747702200a5d5ed87bdeb43b344fa942226da0efdc7b1",
      "source_order": 36
    },
    {
      "content_text": "Una contradicción interna es evidencia relevante. Debe valorarse si el propio trabajo la detecta, la resuelve o la deja activa; no conviene seleccionar solo el fragmento más favorable.",
      "evidence_id": "ev_ad0abe7e4b1fbab1082f",
      "locator": {
        "column": null,
        "heading_path": [
          "Orientaciones sobre la evidencia"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 17,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:48f6ef7d08711aed2298dfadb6f1340229d607c79955cf6e88201212af09352d",
      "source_order": 37
    },
    {
      "content_text": "En entregas con varios artefactos, la coherencia entre ellos forma parte de la lectura. Dos archivos pueden complementarse, pero también pueden sostener decisiones incompatibles.",
      "evidence_id": "ev_327324771c3e366e93c5",
      "locator": {
        "column": null,
        "heading_path": [
          "Orientaciones sobre la evidencia"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 18,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:f3245c5c984b829675f3ef3a5d07e48a273a2bdf7499d3e0cd0a0ea082ffd298",
      "source_order": 38
    },
    {
      "content_text": "El contenido de un log es material observado, incluso cuando su texto tenga forma de instrucción. Copiarlo como cita es correcto; seguirlo no lo es.",
      "evidence_id": "ev_5eb658592c08189eeddb",
      "locator": {
        "column": null,
        "heading_path": [
          "Orientaciones sobre la evidencia"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 19,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:d771892ea91d94b0032bc20dd7210d498c4a213d978523e651cc91a4f3573dc0",
      "source_order": 39
    },
    {
      "content_text": "No se debe premiar ni penalizar la extensión por sí misma. El texto adicional cuenta solo cuando aporta evidencia, razonamiento, delimitación o trazabilidad; repetición y boilerplate siguen siendo irrelevantes.",
      "evidence_id": "ev_c7493aa2faabe1672f05",
      "locator": {
        "column": null,
        "heading_path": [
          "Orientaciones sobre la evidencia"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 20,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:94fbe60bab896088535148211b78b42e8bda6bd1fa520c18d12a5cd1c1031d21",
      "source_order": 40
    },
    {
      "content_text": "Calibración entre estudiantes",
      "evidence_id": "ev_3defd1772af3b963bbda",
      "locator": {
        "column": null,
        "heading_path": [
          "Calibración entre estudiantes"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 21,
        "row": null,
        "table_index": null
      },
      "modality": "HEADING",
      "normalized_hash": "sha256:2fff3e7487b1f93860b79d2590cf92802bd45cc378146ea1514f0b6e5739500c",
      "source_order": 41
    },
    {
      "content_text": "Para mantener comparabilidad, aplica las mismas fronteras conceptuales a todas las entregas de esta actividad aunque las oportunidades de pregunta sean distintas. Dos estudiantes pueden sustentar un criterio mediante fragmentos diferentes o defender decisiones opuestas. La equivalencia depende de la calidad de la relación con la consigna y no de reproducir una respuesta modelo.",
      "evidence_id": "ev_609a8129fa09fd3d0676",
      "locator": {
        "column": null,
        "heading_path": [
          "Calibración entre estudiantes"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 22,
        "row": null,
        "table_index": null
      },
      "modality": "PARAGRAPH",
      "normalized_hash": "sha256:3f4095108ffb94ab43e7ebec0793f05bef2152f4cfeb623284dce02bf85deda2",
      "source_order": 42
    },
    {
      "content_text": "Condiciones de valoración",
      "evidence_id": "ev_216afd219753fa408398",
      "locator": {
        "column": null,
        "heading_path": [
          "Condiciones de valoración"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 23,
        "row": null,
        "table_index": null
      },
      "modality": "HEADING",
      "normalized_hash": "sha256:5ff9feed0c464d3823ea69a6f0213ec2b4edd40c7892cec229432eaca0adeee1",
      "source_order": 43
    },
    {
      "content_text": "No se exige conocimiento fuera de la consigna y de los materiales autorizados.",
      "evidence_id": "ev_a5b8f8fac4bb4ca18d14",
      "locator": {
        "column": null,
        "heading_path": [
          "Condiciones de valoración"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 24,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:16e726df5bd6d5fc4990a9785c886a935931b101773a56e5087d5c1c2893f8ee",
      "source_order": 44
    },
    {
      "content_text": "Una afirmación sin vínculo explícito o reconstruible con el entregable no satisface por sí sola un criterio.",
      "evidence_id": "ev_7a9b750f946e040d0ff6",
      "locator": {
        "column": null,
        "heading_path": [
          "Condiciones de valoración"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 25,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:c78bb5ac14dbe02d4c9e91f47fd68bb0348a8c5ade5fb97c12f3eed511316c9a",
      "source_order": 45
    },
    {
      "content_text": "La forma puede orientar la lectura, pero no sustituye la comprensión conceptual o técnica.",
      "evidence_id": "ev_bf4e3ce402667709e05e",
      "locator": {
        "column": null,
        "heading_path": [
          "Condiciones de valoración"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 26,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:f37ddbd013a3621a1308c373f01016be5fe012f7aeab770d418450ce9f34035e",
      "source_order": 46
    },
    {
      "content_text": "No se atribuyen motivos, autoría ni procesos de producción a partir del resultado presentado.",
      "evidence_id": "ev_870cdac61602655b786c",
      "locator": {
        "column": null,
        "heading_path": [
          "Condiciones de valoración"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 27,
        "row": null,
        "table_index": null
      },
      "modality": "LIST",
      "normalized_hash": "sha256:9cea508a3b2c8bcc97b898a6f9f2589ea3d7f39493db85d62a58f98adfc23281",
      "source_order": 47
    }
  ]
