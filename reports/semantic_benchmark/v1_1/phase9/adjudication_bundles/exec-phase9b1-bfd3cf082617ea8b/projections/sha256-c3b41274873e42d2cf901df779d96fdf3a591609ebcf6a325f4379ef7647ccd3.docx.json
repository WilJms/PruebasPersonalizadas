      },
      "modality": "TABLE",
      "normalized_hash": "sha256:eab9f5fa8bf65ebd2364b5a3f062f492d8fdfe6e83353af82975ba736a7179fa",
      "source_order": 15
    },
    {
      "content_text": "Parcialmente logrado",
      "evidence_id": "ev_d098b9834a15a206b3ff",
      "locator": {
        "column": 2,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 0,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:531ab4dd233072d1039796991c7d05702ebf8b8a327c2db26adaf75fa65526fe",
      "source_order": 16
    },
    {
      "content_text": "No sustentado",
      "evidence_id": "ev_e3ef4f1b469cdc35b566",
      "locator": {
        "column": 3,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 0,
