    },
    {
      "content_text": "Claramente logrado",
      "evidence_id": "ev_05ed6f82bb01fc38f020",
      "locator": {
        "column": 1,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
