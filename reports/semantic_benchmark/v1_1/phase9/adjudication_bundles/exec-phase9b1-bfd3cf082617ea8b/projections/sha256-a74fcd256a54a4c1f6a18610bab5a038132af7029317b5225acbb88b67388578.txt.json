      "source_order": 0
    },
    {
      "content_text": "El cuento trata de secretos. Es muy profundo.",
      "evidence_id": "ev_46fdcf7ea49ad7b11095",
      "locator": {
        "column": null,
        "heading_path": [],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 1,
