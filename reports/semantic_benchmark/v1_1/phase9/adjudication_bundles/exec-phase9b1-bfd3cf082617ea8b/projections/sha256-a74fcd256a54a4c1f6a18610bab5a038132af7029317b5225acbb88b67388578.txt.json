  "units": [
    {
      "content_text": "La autora nació en Puerto Azul en 1982 y escribió este cuento después de perder su casa. Su color favorito era el azul. Esto explica el sobre y el carácter autobiográfico del texto.",
      "evidence_id": "ev_8c4e84959f4828f71c44",
      "locator": {
        "column": null,
