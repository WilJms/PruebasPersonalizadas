      "source_order": 15
    },
    {
      "content_text": "Parcialmente logrado",
      "evidence_id": "ev_6043209a9b440498b068",
      "locator": {
        "column": 2,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 0,
        "table_index": 0
      },
      "modality": "TABLE",
      "normalized_hash": "sha256:531ab4dd233072d1039796991c7d05702ebf8b8a327c2db26adaf75fa65526fe",
      "source_order": 16
    },
    {
      "content_text": "No sustentado",
      "evidence_id": "ev_d36862b87d2e96129a6e",
      "locator": {
        "column": 3,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": null,
        "row": 0,
