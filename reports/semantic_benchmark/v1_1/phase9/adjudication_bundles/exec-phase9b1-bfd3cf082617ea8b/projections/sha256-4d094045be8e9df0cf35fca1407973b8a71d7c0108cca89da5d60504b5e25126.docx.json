    {
      "content_text": "Claramente logrado",
      "evidence_id": "ev_05d750e2d106f79ad20a",
      "locator": {
        "column": 1,
        "heading_path": [
          "Criterios"
        ],
        "kind": "DOCUMENT_PATH",
