      "source_order": 1
    },
    {
      "content_text": "Comentario argumentativo sobre un texto incluido en la consigna",
      "evidence_id": "ev_954ed864e88c788716b7",
      "locator": {
        "column": null,
        "heading_path": [],
        "kind": "DOCUMENT_PATH",
        "paragraph_index": 2,
