    },
    {
      "content_text": "Disciplina: Humanidades - literatura   |   Dificultad del paquete: simple",
      "evidence_id": "ev_3dc9d3e1899f2dfe99ed",
      "locator": {
        "column": null,
        "heading_path": [],
        "kind": "DOCUMENT_PATH",
