{
  "name": "comprehension-verification-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "openapi:generate": "openapi-typescript ../tests/fixtures/openapi/stage1-v1.json -o src/api/generated.ts --alphabetize",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:stage2": "playwright test --config playwright.stage2.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
