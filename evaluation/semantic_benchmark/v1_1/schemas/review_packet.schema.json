{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pruebas-personalizadas.invalid/schemas/semantic-benchmark/1.1.0/review-packet.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "stage", "fixture_id", "route_or_opportunity_id", "binding_scope", "candidate_output", "candidate_output_hash", "relevant_source_refs", "property", "defensible_alternatives", "oracle_state", "source_hashes"],
  "properties": {
    "schema_version": {"const": "semantic-review-packet/1.1.0"},
    "case_id": {"type": "string"},
    "stage": {"enum": ["P04", "P06", "P07", "P09"]},
    "fixture_id": {"type": "string", "minLength": 1},
    "route_or_opportunity_id": {"type": ["string", "null"]},
    "binding_scope": {"enum": ["CASE_SPECIFIC", "SUBMISSION_WIDE", "ACTIVITY_WIDE", "FIXTURE_WIDE"]},
    "candidate_output": {},
    "candidate_output_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "relevant_source_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "property": {"type": "object"},
    "defensible_alternatives": {"type": "array", "items": {"type": "string"}},
    "oracle_state": {"enum": ["VALID", "ORACLE_SUSPECT", "NOT_APPLICABLE"]},
    "source_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
  }
}
