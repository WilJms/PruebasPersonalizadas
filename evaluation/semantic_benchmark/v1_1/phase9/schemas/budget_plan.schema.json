{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pruebas-personalizadas.invalid/schemas/phase9/1.0.0/budget-plan.json",
  "title": "Frozen Phase 9 budget plan",
  "description": "Caps only. Freezing a cap is not authorizing a spend: authorization stays NONE and no billable authorization exists until Phase 9B issues one explicitly. Every figure is an ESTIMATE_NOT_BILL derived from measured request envelopes and the official pricing snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authorization",
    "billable_authorization_created",
    "disclaimer",
    "pricing_snapshot_retrieved_at",
    "pricing_official_source",
    "token_estimation",
    "margins",
    "per_candidate",
    "per_stage",
    "global_cap_usd",
    "fail_closed_rule"
  ],
  "properties": {
    "schema_version": {"const": "phase9-budget-plan/1.0.0"},
    "status": {"const": "BUDGET_PLAN_FROZEN"},
    "authorization": {"const": "NONE"},
    "billable_authorization_created": {"const": false},
    "disclaimer": {"const": "ESTIMATE_NOT_BILL"},
    "pricing_snapshot_retrieved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "pricing_official_source": {"type": "string", "pattern": "^https://developers\\.openai\\.com/"},
    "token_estimation": {
      "type": "object",
      "required": ["bytes_per_token_divisor", "input_envelopes", "full_context_window_not_used_as_expected_cost"],
      "properties": {
        "bytes_per_token_divisor": {"type": "number", "exclusiveMinimum": 0},
        "full_context_window_not_used_as_expected_cost": {"const": true}
      }
    },
    "margins": {"type": "object"},
    "per_candidate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_id", "stage", "per_call_cap_usd", "rungs", "full_ladder_cap_usd"],
        "properties": {
          "per_call_cap_usd": {"type": "number", "exclusiveMinimum": 0},
          "full_ladder_cap_usd": {"type": "number", "exclusiveMinimum": 0},
          "rungs": {
            "type": "object",
            "required": ["SMOKE", "CORE", "HELD_OUT_CONFIRMATION"],
            "additionalProperties": {
              "type": "object",
              "required": ["cases", "k", "calls", "cap_usd", "technical_retry_reserve_usd"],
              "properties": {
                "k": {"const": 3},
                "cap_usd": {"type": "number", "minimum": 0},
                "technical_retry_reserve_usd": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "per_stage": {
      "type": "object",
      "required": ["P04", "P06", "P07", "P09"],
      "additionalProperties": {
        "type": "object",
        "required": ["stage_cap_usd", "technical_retry_reserve_usd"],
        "properties": {"stage_cap_usd": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "global_cap_usd": {"type": "number", "exclusiveMinimum": 0},
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
