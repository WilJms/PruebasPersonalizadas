{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pruebas-personalizadas.invalid/schemas/phase9/1.1.0/pricing-snapshot.json",
  "title": "Official OpenAI pricing snapshot",
  "description": "Prices read directly from the official OpenAI pricing page on retrieved_at. Repository history is never an acceptable source. Version 1.1.0 prices only the families this protocol can bill (Terra activity-side, Luna submission-side) and records the 9A.1 re-verification. Phase 9B must still re-read the same official page immediately before the first real call and stop on any difference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "retrieved_at",
    "official_source",
    "source_authority",
    "pricing_unit",
    "copied_from_repository_history",
    "models",
    "notes",
    "refresh_guard",
    "reverification",
    "priced_model_families_note"
  ],
  "properties": {
    "schema_version": {
      "const": "phase9-pricing-snapshot/1.1.0"
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "official_source": {
      "type": "string",
      "pattern": "^https://developers\\.openai\\.com/"
    },
    "source_authority": {
      "const": "OFFICIAL_OPENAI_ONLY"
    },
    "pricing_unit": {
      "const": "USD_PER_MILLION_TOKENS"
    },
    "copied_from_repository_history": {
      "const": false
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "input_price",
          "cached_input_price",
          "output_price"
        ],
        "properties": {
          "model": {
            "enum": [
              "gpt-5.6-luna",
              "gpt-5.6-terra"
            ]
          },
          "input_price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cached_input_price": {
            "type": "number",
            "minimum": 0
          },
          "output_price": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "maxItems": 2
    },
    "refresh_guard": {
      "type": "object",
      "required": [
        "when",
        "action",
        "on_any_difference"
      ],
      "properties": {
        "when": {
          "const": "IMMEDIATELY_BEFORE_THE_FIRST_REAL_CALL_OF_PHASE_9B"
        },
        "on_any_difference": {
          "const": "STOP_DO_NOT_EXECUTE"
        }
      }
    },
    "priced_model_families_note": {
      "type": "string",
      "minLength": 1
    },
    "reverification": {
      "type": "object",
      "required": [
        "status",
        "reverified_at",
        "reverified_for",
        "sources_reread",
        "checked",
        "authority",
        "repository_history_used_as_authority",
        "does_not_replace_9b_refresh"
      ],
      "properties": {
        "status": {
          "const": "REVERIFIED_UNCHANGED"
        },
        "reverified_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "authority": {
          "const": "OFFICIAL_OPENAI_ONLY"
        },
        "repository_history_used_as_authority": {
          "const": false
        },
        "max_reasoning_effort_confirmed_available": {
          "const": true
        },
        "sources_reread": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://developers\\.openai\\.com/"
          }
        }
      }
    }
  }
}
